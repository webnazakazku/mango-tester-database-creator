{
	"name": "webnazakazku/mango-tester-database-creator",
	"type": "library",
	"license": "MIT",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/webnazakazku/mango-tester-infrastructure"
		}
	],
	"require": {
		"php": ">=8.2",
		"nette/di": "~3.0"
	},
	"require-dev": {
		"nextras/dbal": "^4.0",
		"nextras/orm": "^4.0",
		"nextras/migrations": "^3.1",
		"contributte/qa": "^0.4",
		"phpstan/phpstan": "^1.0",
		"webnazakazku/mango-tester-infrastructure": "^0.7"
	},
	"suggest": {
		"nextras/dbal": "",
		"nextras/orm": "",
		"nextras/migrations": ""
	},
	"autoload": {
		"classmap": [
			"src"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
